# Namuna. Haqiqiy qiymatlar .env.local da bo'ladi (git'ga tushmaydi).

# Ma'lumot va yuklangan fayllar shu yerda saqlanadi (Project Settings → API).
# ⚠️ SERVICE_ROLE kaliti — anon/public emas, to'liq yozish huquqi bilan.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_USERNAME=admin
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Avtomatik tarjima provayderi: google (standart, bepul) yoki claude.
TRANSLATE_PROVIDER=google

# Faqat TRANSLATE_PROVIDER=claude bo'lganda kerak (pullik).
# Kalit: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Admin paneldagi AI to'ldirish (mahsulot) va AI maqola tayyorlash uchun.
# Bepul kalit: https://aistudio.google.com/apikey
GEMINI_API_KEY=
